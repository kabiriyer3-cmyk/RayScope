1 ICON "rayscope.ico"

1 VERSIONINFO
FILEVERSION @VERSION_COMMA@,0
PRODUCTVERSION @VERSION_COMMA@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RayScope"
            VALUE "FileDescription", "RayScope"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "RayScope"
            VALUE "OriginalFilename", "RayScope.exe"
            VALUE "ProductName", "RayScope"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
